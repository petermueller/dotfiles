#!/bin/bash

# Enable Touch ID for sudo on macOS
# This script configures /etc/pam.d/sudo_local to enable Touch ID authentication
# Hash: {{ include "sudo_local.tmpl" | sha256sum }}

set -e

# Check if we're on macOS
if [[ "$(uname)" != "Darwin" ]]; then
    echo "Skipping Touch ID sudo configuration (not on macOS)"
    exit 0
fi

TARGET="/etc/pam.d/sudo_local"
TEMP_FILE=$(mktemp)

cat > "$TEMP_FILE" << 'EOF'
{{ include "sudo_local.tmpl" -}}
EOF

# Check if the file already matches our desired content
if [[ -f "$TARGET" ]] && diff -q "$TEMP_FILE" "$TARGET" > /dev/null 2>&1; then
    echo "Touch ID for sudo already configured correctly"
    rm "$TEMP_FILE"
    exit 0
fi

echo "Configuring Touch ID for sudo..."
sudo cp "$TEMP_FILE" "$TARGET"
sudo chmod 644 "$TARGET"
sudo chown root:wheel "$TARGET"
rm "$TEMP_FILE"
echo "Touch ID for sudo configured successfully"
