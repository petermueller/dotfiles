#!/bin/sh
#MISE description="Fetch the SSH key pair from Bitwarden into ~/.ssh (not needed with Bitwarden's SSH agent)"
#MISE raw=true
set -eu

# Optional. SSH normally goes through Bitwarden Desktop's SSH agent (see
# SSH_AUTH_SOCK in the fish config). This puts the key pair on disk for the
# cases where that agent is not available.
#
# The key pair lives in Bitwarden as two attachments on this item. Nothing
# secret is stored in this repo.
item="a6a40ac9-fb9b-40d1-9e17-b0f10044b16a"
key="petermuellercodes_ed25519"
dir="$HOME/.ssh"

if [ -f "$dir/$key" ] && [ -f "$dir/$key.pub" ]; then
  echo "$dir/$key is already in place"
  exit 0
fi

root="${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$root/lib/bw.sh"

umask 077
mkdir -p "$dir"
"$bw" get attachment "$key" --itemid "$item" --output "$dir/$key"
"$bw" get attachment "$key.pub" --itemid "$item" --output "$dir/$key.pub"
chmod 600 "$dir/$key"
chmod 644 "$dir/$key.pub"
echo "Installed $dir/$key and $dir/$key.pub"
