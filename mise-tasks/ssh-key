#!/bin/sh
#MISE description="Fetch the SSH key pair from Bitwarden into ~/.ssh"
#MISE raw=true
set -eu

# The key pair lives in Bitwarden as two attachments on this item. Nothing
# secret is stored in this repo.
item="a6a40ac9-fb9b-40d1-9e17-b0f10044b16a"
key="petermuellercodes_ed25519"
dir="$HOME/.ssh"

if [ -f "$dir/$key" ] && [ -f "$dir/$key.pub" ]; then
  echo "$dir/$key is already in place"
  exit 0
fi

bw=$(command -v bw || true)
if [ -z "$bw" ]; then
  bw=/opt/homebrew/bin/bw
fi
if [ ! -x "$bw" ]; then
  echo "bitwarden-cli (bw) is not installed. Run: mise bootstrap packages apply" >&2
  exit 1
fi

# `bw status` reports unauthenticated, locked or unlocked. Logging in and
# unlocking prompt on the terminal; --raw prints only the session key.
status=$("$bw" status | sed -E 's/.*"status":"([a-z]+)".*/\1/')
case "$status" in
  unauthenticated) BW_SESSION=$("$bw" login --raw) ;;
  locked) BW_SESSION=$("$bw" unlock --raw) ;;
  unlocked) : "${BW_SESSION:?vault is unlocked but BW_SESSION is not set in this shell}" ;;
  *)
    echo "unexpected 'bw status': $status" >&2
    exit 1
    ;;
esac
export BW_SESSION

umask 077
mkdir -p "$dir"
"$bw" get attachment "$key" --itemid "$item" --output "$dir/$key"
"$bw" get attachment "$key.pub" --itemid "$item" --output "$dir/$key.pub"
chmod 600 "$dir/$key"
chmod 644 "$dir/$key.pub"
echo "Installed $dir/$key and $dir/$key.pub"
